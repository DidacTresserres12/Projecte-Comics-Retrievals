import torch
from torch.utils.data import Dataset
import torchvision.transforms as T
from datasets import load_dataset

class ComicsPAPDataset(Dataset):
    def __init__(self, hf_dataset, tokenizer, max_length=128):
        self.ds = hf_dataset
        self.tokenizer = tokenizer
        self.max_length = max_length
        # Transformació per a ResNet (Imatges de còmics a 224x224)
        self.transform = T.Compose([
            T.Resize((224, 224)),
            T.ToTensor(),
            T.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225])
        ])

    def __len__(self):
        return len(self.ds)

    def __getitem__(self, idx):
        item = self.ds[idx]
        # Imatge: convertim a RGB per evitar errors amb imatges en escala de grisos
        image = item['image'].convert('RGB')
        image = self.transform(image)
        
        # Text: Tokenització BERT
        encoding = self.tokenizer(
            item['caption'],
            padding='max_length',
            truncation=True,
            max_length=self.max_length,
            return_tensors='pt'
        )

        return {
            'image': image,
            'input_ids': encoding['input_ids'].flatten(),
            'attention_mask': encoding['attention_mask'].flatten()
        }